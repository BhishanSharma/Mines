<?xml version="1.0" encoding="utf-8"?>
<!--
    Adaptive-icon foreground layer. Launchers crop this 108dp canvas to
    varying mask shapes (circle, squircle, rounded square...), guaranteeing
    only the inner 72dp ("safe zone") is always visible - so mine_logo is
    scaled to exactly that size and centered, instead of being placed at
    full bleed where its outer spikes would get clipped on some devices.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:drawable="@drawable/mine_logo"
        android:gravity="center"
        android:width="72dp"
        android:height="72dp" />
</layer-list>